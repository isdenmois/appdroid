# Copy this file to .env at the repo root for local development.
# It is only loaded when GIN_MODE is not "release" (i.e. local `just run`).
# Real environment variables always take precedence over values here.

# Shared secret sent by the admin frontend in the X-API-Key header.
# Set it to a long random value; the server fails closed (rejects all
# mutating requests) until it is configured.
API_KEY=change-me

# These mirror the project defaults; override them locally as needed.
# PORT=3000
# DATA_DIR=./data
# SERVER_MODE=dev
